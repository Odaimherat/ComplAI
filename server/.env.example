# All variables are optional; the app runs with sensible fallbacks if unset.

# MongoDB connection string. Leave unset to run without persistence
# (contact/newsletter submissions are accepted but not stored).
# Free option: a MongoDB Atlas free-tier cluster, e.g.
# mongodb+srv://user:pass@cluster0.mongodb.net/complai
MONGODB_URI=

# Port the Express API listens on.
PORT=4000

# Allowed origin for CORS, e.g. http://localhost:5173 in development.
CLIENT_ORIGIN=http://localhost:5173

# Admin dashboard login (see docs/design-and-research-report.md section on
# admin auth for the honest scope note - this is a single shared password,
# not a real multi-user account system). Change this in any real deployment.
ADMIN_PASSWORD=complai-admin

# Secret used to sign admin session tokens (JWT). Change this in any real
# deployment; the fallback value is fine for local/demo use only.
JWT_SECRET=complai-dev-secret-change-me
