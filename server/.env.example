# All variables are optional; the app runs with sensible fallbacks if unset.

# MongoDB connection string. Leave unset to run without persistence
# (contact/newsletter submissions are accepted but not stored).
# Free option: a MongoDB Atlas free-tier cluster, e.g.
# mongodb+srv://user:pass@cluster0.mongodb.net/complai
MONGODB_URI=

# Port the Express API listens on.
PORT=4000

# Allowed origin for CORS, e.g. http://localhost:5173 in development.
CLIENT_ORIGIN=http://localhost:5173
